# Create a key at https://openrouter.ai/settings/keys.
OPENROUTER_API_KEY=sk-or-v1-replace-me

# Use the paid Inkling endpoint. The :free endpoint is intentionally rejected
# because it is limited to agentic harnesses and is not appropriate for private
# message content.
OPENROUTER_MODEL=thinkingmachines/inkling

# Both privacy controls are on by default in server_inkling.py.
OPENROUTER_ZDR=1
OPENROUTER_DENY_DATA_COLLECTION=1
OPENROUTER_TIMEOUT_MS=30000

PORT=5058
